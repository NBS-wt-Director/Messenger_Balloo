FROM node:22-slim AS builder

WORKDIR /app

# libatomic1 is required by the pnpm@11 prebuilt binary (@pnpm/exe)
RUN apt-get update -y && apt-get install -y --no-install-recommends libatomic1 && rm -rf /var/lib/apt/lists/*

# Install pnpm + typescript + vite globally
RUN npm install -g pnpm@latest typescript vite@5.4.0

# Copy workspace config and root package.json
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* .npmrc ./
COPY packages/shared/package.json packages/shared/
COPY packages/web/package.json packages/web/

# Install dependencies (all workspace deps)
RUN pnpm install --frozen-lockfile || pnpm install

# Copy source
COPY packages/shared/ packages/shared/
COPY packages/web/ packages/web/

# Generate Prisma client (needed for shared build)
RUN cd packages/shared && npx prisma generate

# Build shared
RUN cd packages/shared && tsc

# API base URL baked into the bundle at build time (Vite inlines VITE_* vars only)
# Must be a bare origin without trailing slash: code does `${API_BASE}/api/...`
ARG VITE_API_URL=https://balloo.su
ENV VITE_API_URL=${VITE_API_URL}

# Build web (vite build — no type-check, faster)
RUN cd packages/web && vite build

# ---------- Production stage — serve with nginx ----------
FROM nginx:alpine

# Copy built files
COPY --from=builder /app/packages/web/dist /usr/share/nginx/html

# Copy nginx config
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
