# syntax=docker/dockerfile:1
FROM node:22-slim AS builder

WORKDIR /app

# libatomic1 required by pnpm@11 prebuilt binary; apt cache mount speeds rebuilds
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update -y && apt-get install -y --no-install-recommends libatomic1

# Pin pnpm to version from packageManager field (avoids cache busting on "latest")
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable && corepack prepare pnpm@11.17.0 --activate

# Copy manifests only — this layer is cached until lockfile changes
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* .npmrc ./
COPY packages/shared/package.json packages/shared/
COPY packages/ui/package.json packages/ui/
COPY packages/web/package.json packages/web/
COPY packages/web-features/package.json packages/web-features/
COPY packages/web-admin/package.json packages/web-admin/

# Install all deps — pnpm store AND prisma engines persist across builds
RUN --mount=type=cache,id=pnpm-web,target=/root/.local/share/pnpm/store,sharing=shared \
    --mount=type=cache,id=prisma-engines,target=/root/.cache/prisma,sharing=shared \
    pnpm install --frozen-lockfile || pnpm install

# Copy Prisma schema SEPARATELY — prisma generate is cached unless schema changes
COPY packages/shared/prisma/ packages/shared/prisma/
RUN --mount=type=cache,id=prisma-engines,target=/root/.cache/prisma,sharing=shared \
    cd packages/shared && npx prisma generate

# Copy full source (invalidates only build layers, not prisma generate)
COPY packages/shared/ packages/shared/
# @balloo/ui (тик. №1): исходники TS импортируются web через vite/tsconfig alias
COPY packages/ui/ packages/ui/
COPY packages/web/ packages/web/
COPY packages/web-features/ packages/web-features/
# web-admin (тикет 1792395490-05): alias @ → ../web/src, исходники web уже скопированы
COPY packages/web-admin/ packages/web-admin/

# Build shared (local tsc from node_modules, no global install needed)
RUN cd packages/shared && ./node_modules/.bin/tsc

# API base URL baked into the bundle at build time (Vite inlines VITE_* vars only)
# Must be a bare origin without trailing slash: code does `${API_BASE}/api/...`
# Ticket #0 (subdomains multitticket, 2026-09-20): all API served from the
# dedicated api.balloo.su subdomain; the client appends /api/... itself.
ARG VITE_API_URL=https://api.balloo.su
ENV VITE_API_URL=${VITE_API_URL}

# Build web (vite build — no type-check, faster; local vite from node_modules)
RUN cd packages/web && ./node_modules/.bin/vite build

# Build features (features.balloo.su — публичная витрина фич)
RUN cd packages/web-features && ./node_modules/.bin/vite build

# Build web-admin (admin.balloo.su — админ-панель, тикет 1792395490-05)
RUN cd packages/web-admin && ./node_modules/.bin/vite build

# ---------- Production stage — web SPA served with nginx ----------
FROM nginx:alpine AS web

# Copy built files
COPY --from=builder /app/packages/web/dist /usr/share/nginx/html

# Copy nginx config
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

# ---------- Production stage — features SPA served with nginx ----------
FROM nginx:alpine AS features

COPY --from=builder /app/packages/web-features/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

# ---------- Production stage — web-admin SPA served with nginx ----------
# admin.balloo.su (тикеты 1792395490-05, 1792812416). Хостовый nginx
# (docker/prod/nginx/balloo-docker.conf) проксирует на порт этого контейнера.
FROM nginx:alpine AS web_admin

COPY --from=builder /app/packages/web-admin/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
