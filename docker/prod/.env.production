# ============================================
# JWT — токены аутентификации
# ============================================
# Access token: 15 минут
JWT_ACCESS_SECRET="663cb016df1bd460eb4c201e1930b8a95bced252cf1d66e5d95d8973aa92304a"
JWT_ACCESS_EXPIRES_IN="900"
# Refresh token: 30 дней
JWT_REFRESH_SECRET="86bc8d272f18a3ea95196e8533f005778ab61d65c85c71f178a1e74b9ac85a17"
JWT_REFRESH_EXPIRES_IN="2592000"

# ============================================
# Server — бэкенд
# ============================================
SERVER_PORT="3000"
SERVER_HOST="0.0.0.0"
NODE_ENV="production"

# ============================================
# WEB_HOST_PORT — хостовый порт фронтенда (публикуется на 127.0.0.1).
# 8080 на сервере занят чужим node-процессом, поэтому 8090.
# server (3100) и minio (9001) НЕ трогаем — это наши контейнеры.
# ============================================
WEB_HOST_PORT=8090

# ============================================
# VITE_API_URL — базовый URL API, ЗАПЕКАЕТСЯ в бандль
# фронтенда на этапе vite build (см. docker/Dockerfile.web,
# build.args в docker-compose.local.yml). Голый origin без слэша.
# NEXT_PUBLIC_* — НЕЛЬЗЯ: это Next.js, а web собирается Vite'ом.
# Тикет №0 (мультитикет поддоменов, 2026-09-20): всё API — на отдельный
# поддомен api.balloo.su. Клиент сам дописывает /api/... (services/api.ts:5,
# OAuth-редиректы LoginScreen/RegisterScreen), итоговые URL:
# https://api.balloo.su/api/auth/.... WS строится из этого же origin в
# screens/chat/ChatViewScreen.tsx: API_BASE.replace('http','ws') + '/ws/?token='
# ⇒ wss://api.balloo.su/ws/ (сервер: ws/index.ts path '/ws/').
# ============================================
VITE_API_URL="https://api.balloo.su"

# ============================================
# APP_URL — публичный origin ФРОНТЕНДА (один URL, НЕ список).
# Куда возвращаем после OAuth, откуда ссылки писем (verify/reset) и возврат
# платежей. Отделён от CORS_ORIGIN, который стал списком из 8 поддоменов.
# ============================================
APP_URL="https://balloo.su"

# ============================================
# CORS — разрешённые домены (СПИСОК через запятую, без пробелов).
# Только middleware/cors.ts (split(','), credentials:true) и CSP connectSrc.
# Никаких '*' с credentials. Полный список origin'ов Варианта C (§3.3).
# ============================================
CORS_ORIGIN="https://balloo.su,https://admin.balloo.su,https://command.balloo.su,https://features.balloo.su,https://blog.balloo.su,https://history.balloo.su,https://download.balloo.su,https://docs.balloo.su"

# ============================================
