{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "row",
      "title": "Server Overview",
      "id": 1,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}
    },
    {
      "type": "stat",
      "title": "Server Uptime",
      "id": 2,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "process_uptime_seconds{job=\"balloo-server\"} / 86400",
          "legendFormat": "days"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 7},
              {"color": "red", "value": 30}
            ]
          }
        }
      },
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1}
    },
    {
      "type": "stat",
      "title": "Request Rate",
      "id": 3,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"balloo-server\"}[5m]))",
          "legendFormat": "req/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1}
    },
    {
      "type": "stat",
      "title": "Error Rate (5xx)",
      "id": 4,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"balloo-server\",status=~\"5..\"}[5m]))",
          "legendFormat": "5xx/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.1},
              {"color": "red", "value": 1}
            ]
          }
        }
      },
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1}
    },
    {
      "type": "timeseries",
      "title": "HTTP Requests (all)",
      "id": 5,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"balloo-server\"}[5m])) by (method, status)",
          "legendFormat": "{{method}} {{status}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5}
    },
    {
      "type": "timeseries",
      "title": "Response Time (p50, p95, p99)",
      "id": 6,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(http_request_duration_seconds_bucket{job=\"balloo-server\"}[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"balloo-server\"}[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"balloo-server\"}[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5}
    },
    {
      "type": "row",
      "title": "System Resources",
      "id": 7,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 13}
    },
    {
      "type": "timeseries",
      "title": "Memory Usage",
      "id": 8,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"balloo-server\"}",
          "legendFormat": "RSS"
        }
      ],
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 14}
    },
    {
      "type": "timeseries",
      "title": "CPU Usage",
      "id": 9,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{job=\"balloo-server\"}[5m])",
          "legendFormat": "CPU"
        }
      ],
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 14}
    },
    {
      "type": "timeseries",
      "title": "Open File Descriptors",
      "id": 10,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "node_filefd_allocated{job=\"node\"}",
          "legendFormat": "open"
        }
      ],
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 14}
    },
    {
      "type": "row",
      "title": "WebSocket & Real-time",
      "id": 11,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 20}
    },
    {
      "type": "timeseries",
      "title": "Active WebSocket Connections",
      "id": 12,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(ws_connections_active{job=\"balloo-server\"}) or vector(0)",
          "legendFormat": "active connections"
        }
      ],
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 21}
    },
    {
      "type": "timeseries",
      "title": "Messages Per Second",
      "id": 13,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(ws_messages_total{job=\"balloo-server\"}[5m])) or vector(0)",
          "legendFormat": "msg/s"
        }
      ],
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 21}
    }
  ],
  "refresh": "30s",
