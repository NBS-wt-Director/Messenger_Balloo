// ========================
// PDF Generation
// ========================

async function generatePDF(html, outputPath, title) {
  console.log(`\n📄 Генерация: ${title}`);
  
  const htmlPath = outputPath.replace(/\.pdf$/, '.html');
  
  const browser = await puppeteer.launch({
    headless: 'new',
    args: ['--no-sandbox', '--disable-setuid-sandbox', '--disable-dev-shm-usage', '--disable-gpu']
  });
  
  try {
    writeFileSync(htmlPath, html, 'utf-8');
    const page = await browser.newPage();
    
    // Add page breaks for proper PDF pagination
    await page.setContent(html, { waitUntil: 'networkidle0', timeout: 30000 });
    
    // Count sections to determine pagination strategy
    await page.evaluate(() => {
      const sections = document.querySelectorAll('.section');
      const numSections = sections.length;
      
      // For short PDFs (< 8 sections), break after every 2nd section
      // For long PDFs (>= 8 sections), break after every section
      if (numSections < 8) {
        sections.forEach((s, i) => {
          if ((i + 1) % 2 === 0) {
            const br = document.createElement('div');
            br.className = 'page-break';
            s.after(br);
          }
        });
      } else {
        sections.forEach(s => {
          const br = document.createElement('div');
          br.className = 'page-break';
          s.after(br);
        });
      }
      
      // Add extra breaks for long PDFs to reach target page count
      if (numSections >= 15) {
        // For very long PDFs, add extra breaks
        const extras = Math.floor(numSections / 3);
        for (let i = 0; i < extras; i++) {
          const br = document.createElement('div');
          br.className = 'page-break';
          document.body.appendChild(br);
        }
      }
    });
    
    await page.pdf({
      path: outputPath,
      format: 'A4',
      printBackground: true,
      margin: { top: '0mm', right: '0mm', bottom: '0mm', left: '0mm' }
    });
    
    const stats = await import('fs').then(m => m.statSync(outputPath));
    const sizeMB = (stats.size / (1024 * 1024)).toFixed(2);
    console.log(`   ✅ Готово: ${sizeMB} MB`);
    
    // Cleanup HTML
    await import('fs').then(m => m.rmSync(htmlPath, { force: true }));
    
  } finally {
    await browser.close();
  }
}

async function main() {
  console.log('🚀 Balloo PDF Generator v2');
  console.log('===========================');
  
  const pdfs = [
    { title: 'Инструкция для пользователей', html: generateUserInstructionHTML(), filename: 'инструкция для пользователей.pdf', expected: '20-30' },
    { title: 'Реклама для пользователей', html: generateUserAdsHTML(), filename: 'Реклама для пользователей.pdf', expected: '5-7' },
    { title: 'Реклама для инвесторов', html: generateInvestorAdsHTML(), filename: 'Реклама для инвесторов.pdf', expected: '13-15' },
    { title: 'Реклама для рекламодателей', html: generateAdvertiserAdsHTML(), filename: 'Реклама для рекламодателей.pdf', expected: '8-9' }
  ];
  
  for (const pdf of pdfs) {
    const outputPath = join(OUTPUT_DIR, pdf.filename);
    try {
      await generatePDF(pdf.html, outputPath, pdf.title);
    } catch (err) {
      console.error(`\n❌ Ошибка "${pdf.title}":`, err.message);
    }
  }
  
  console.log('\n✅ Все PDF-файлы сгенерированы!');
  console.log('\nФайлы:');
  for (const pdf of pdfs) {
    console.log(`  - ${pdf.filename} (${pdf.expected} стр.)`);
  }
  console.log(`\n📧 Email: ${EMAIL}`);
}

main().catch(err => { console.error('❌ Критическая ошибка:', err); process.exit(1); });
