#!/usr/bin/env node
/**
 * Balloo Messenger — PDF Generator v2
 * 
 * Генерирует 4 PDF-файла с увеличенным контентом:
 * 1. Инструкция для пользователей (20-30 стр.)
 * 2. Реклама для пользователей (5-7 стр.)
 * 3. Реклама для инвесторов (13-15 стр.)
 * 4. Реклама для рекламодателей (8-9 стр.)
 */

import puppeteer from 'puppeteer';
import { mkdirSync, writeFileSync, rmSync } from 'fs';
import { join, dirname, resolve } from 'path';
import { fileURLToPath } from 'url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = dirname(__filename);
const PROJECT_ROOT = resolve(__dirname, '..');
const OUTPUT_DIR = PROJECT_ROOT;
const EMAIL = 'o8eryuhtin@yandex.ru';

const COMMON_CSS = `
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: 'Inter', sans-serif; color: #1a1d21; line-height: 1.6; font-size: 10px; }
  @media print {
    @page { size: A4; margin: 20mm; }
    .page { page-break-after: always; min-height: 230mm; padding: 10px 0; }
    .page:last-child { page-break-after: avoid; }
    .page-break { page-break-after: always; }
    .no-break { page-break-inside: avoid; }
  }
  .hero { background: linear-gradient(135deg, #0a0d11, #14191f, #1a2332); color: #f2f5f8; padding: 50px 45px; text-align: center; }
  .hero h1 { font-size: 30px; font-weight: 800; margin-bottom: 12px; }
  .hero h1 .accent { color: #2db84d; }
  .hero p { font-size: 14px; color: #aeb8c4; max-width: 550px; margin: 0 auto; }
  .section { margin-bottom: 24px; }
  .section h2 { font-size: 18px; font-weight: 700; color: #0a0d11; margin-bottom: 12px; padding-bottom: 6px; border-bottom: 2px solid #2db84d; }
  .section h3 { font-size: 13px; font-weight: 600; color: #1a1d21; margin: 16px 0 6px 0; }
  .section p { margin-bottom: 8px; color: #3a3f47; }
  .section ul, .section ol { margin: 8px 0 8px 16px; }
  .section ul li, .section ol li { margin-bottom: 4px; color: #3a3f47; }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin: 16px 0; }
  .card { background: #f5f7fa; border: 1px solid #eef1f5; padding: 16px; border-left: 3px solid #2db84d; }
  .card h4 { font-size: 12px; font-weight: 700; margin-bottom: 6px; color: #0a0d11; }
  .card p { font-size: 9px; color: #5a6573; margin: 0; }
  .step { display: flex; gap: 12px; margin-bottom: 16px; align-items: flex-start; }
  .step-number { flex-shrink: 0; width: 30px; height: 30px; background: #2db84d; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 13px; }
  .step-content h4 { font-size: 12px; font-weight: 600; margin-bottom: 3px; }
  .step-content p { font-size: 9px; color: #5a6573; margin: 0; }
  table { width: 100%; border-collapse: collapse; margin: 12px 0; font-size: 9px; }
  th { background: #0a0d11; color: #f2f5f8; padding: 8px 10px; text-align: left; font-weight: 600; }
  td { padding: 6px 10px; border-bottom: 1px solid #eef1f5; color: #3a3f47; }
  tr:nth-child(even) td { background: #f9fafb; }
  .highlight { background: linear-gradient(135deg, #e8f5e9, #f1f8e9); border-left: 3px solid #2db84d; padding: 12px 16px; margin: 16px 0; }
  .highlight p { margin: 0; color: #1a5c2a; font-weight: 500; font-size: 10px; }
  .cta-box { background: linear-gradient(135deg, #2db84d, #1e9e3e); color: white; padding: 24px 32px; text-align: center; margin: 24px 0; }
  .cta-box h3 { color: white; font-size: 16px; margin-bottom: 6px; border: none; }
  .cta-box p { color: rgba(255,255,255,0.9); font-size: 11px; margin-bottom: 12px; }
  .cta-box .email { font-size: 13px; font-weight: 700; }
  .logo-placeholder { display: inline-flex; align-items: center; gap: 6px; margin-bottom: 16px; }
  .logo-icon { width: 40px; height: 40px; background: linear-gradient(135deg, #2db84d, #1e9e3e); clip-path: polygon(30% 0%, 70% 0%, 100% 30%, 100% 70%, 70% 100%, 30% 100%, 0% 70%, 0% 30%); display: flex; align-items: center; justify-content: center; }
  .logo-icon span { color: white; font-weight: 800; font-size: 16px; }
  .logo-text { font-size: 20px; font-weight: 800; color: #0a0d11; }
  .logo-text .accent { color: #2db84d; }
  .stat-row { display: flex; gap: 18px; margin: 20px 0; }
  .stat-box { flex: 1; text-align: center; padding: 16px; background: #f5f7fa; }
  .stat-box .number { font-size: 26px; font-weight: 800; color: #2db84d; }
  .stat-box .label { font-size: 9px; color: #5a6573; margin-top: 3px; }
  .pdf-footer { margin-top: 32px; padding-top: 12px; border-top: 1px solid #eef1f5; text-align: center; font-size: 8px; color: #939eab; }
  .dark-section { background: #0a0d11; color: #f2f5f8; padding: 24px 32px; margin: 20px 0; }
  .dark-section h3 { color: #2db84d; }
  .dark-section p { color: #aeb8c4; font-size: 9px; }
  .cover { background: linear-gradient(135deg, #0a0d11, #1a2332); color: #f2f5f8; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 297mm; padding: 50px 45px; text-align: center; }
  .cover .logo-icon { width: 80px; height: 80px; margin-bottom: 24px; }
  .cover .logo-icon span { font-size: 32px; }
  .cover h1 { font-size: 36px; font-weight: 900; margin-bottom: 12px; }
  .cover h1 .accent { color: #2db84d; }
  .cover .subtitle { font-size: 15px; color: #aeb8c4; margin-bottom: 32px; }
  .cover .meta { font-size: 10px; color: #727f8d; }
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 16px 0; }
  .info-box { background: #f5f7fa; padding: 14px; border-radius: 4px; }
  .info-box h4 { font-size: 11px; font-weight: 700; margin-bottom: 6px; color: #0a0d11; }
  .info-box p { font-size: 9px; color: #5a6573; margin: 0; }
  .feature-list { columns: 2; column-gap: 20px; margin: 12px 0; }
  .feature-list li { padding: 4px 0; break-inside: avoid; }
`;

function generateUserInstructionHTML() {
  return `<!DOCTYPE html><html><head><meta charset="utf-8"><style>${COMMON_CSS}</style></head><body>
<div class="cover"><div class="logo-icon"><span>B</span></div><h1>Balloo <span class="accent">Messenger</span></h1><div class="subtitle">Полная инструкция для пользователей</div><div class="meta">Версия 1.0 • Июль 2026</div></div>

<div class="page">
<div class="hero"><div class="logo-placeholder" style="justify-content:center;"><div class="logo-icon"><span>B</span></div><div class="logo-text" style="color:#f2f5f8;">Balloo <span class="accent">Messenger</span></div></div><h1>Полная инструкция для пользователей</h1><p>Всё, что нужно знать о мессенджере Balloo: от установки до продвинутых функций</p></div>

<div class="section" style="margin-top:24px;"><h2>1. Что такое Balloo?</h2><p>Balloo — это современный российский мессенджер нового поколения, объединяющий мгновенный обмен сообщениями, голосовые и видеозвонки, сторис, блог-платформу, базу знаний для компаний и систему найма.</p><p>Проект создан для российского и СНГ-рынка с поддержкой 20 языков, включая 15 языков народов Российской Федерации. Balloo предлагает полную альтернативу зарубежным мессенджерам с акцентом на приватность, безопасность и культурную адаптацию.</p><div class="cards"><div class="card"><h4>💬 Мгновенные сообщения</h4><p>Текст, фото, видео, голосовые, файлы до 50 МБ, реакции, ответы, закрепление, редактирование</p></div><div class="card"><h4>👥 Группы и каналы</h4><p>Группы до 200 000 участников, каналы, роли (owner/admin/moderator/member), модерация, invite-ссылки</p></div><div class="card"><h4>📞 Звонки</h4><p>Голосовые и видеозвонки через WebRTC, групповые звонки до 30 человек, качество HD</p></div></div></div>

<div class="section"><h2>2. Установка и запуск</h2><h3>2.1 Веб-версия</h3><p>Откройте <strong>app.balloo.su</strong> в любом современном браузере (Chrome, Firefox, Edge, Safari). Установка не требуется. Работает на десктопе и мобильных устройствах. Поддерживает PWA — можно установить как нативное приложение.</p><h3>2.2 Десктоп (Windows / macOS / Linux)</h3><p>Десктопное приложение построено на Electron и обеспечивает нативный опыт:</p><ol><li>Перейдите на <strong>download.balloo.su</strong></li><li>Выберите вашу платформу (Windows .exe, macOS .dmg, Linux .AppImage)</li><li>Скачайте установочный файл (размер ~85 МБ)</li><li>Запустите установку и следуйте инструкциям мастера</li><li>Авторизуйтесь или создайте новый аккаунт</li></ol><h3>2.3 Мобильные приложения</h3><p>Мобильные приложения на React Native (Expo) скоро в Google Play и App Store. Для раннего доступа используйте веб-версию с PWA-установкой.</p></div>

<div class="section"><h2>3. Регистрация и вход</h2><p>Баллоо поддерживает несколько способов регистрации и авторизации для максимального удобства и безопасности.</p><div class="step"><div class="step-number">1</div><div class="step-content"><h4>Откройте Balloo</h4><p>Перейдите на app.balloo.su или запустите десктопное приложение</p></div></div><div class="step"><div class="step-number">2</div><div class="step-content"><h4>Выберите способ регистрации</h4><p>Email — классическая регистрация с подтверждением на почту. Номер телефона — быстрая регистрация с SMS-кодом. Социальные сети — Yandex ID, VK ID, Mail.ru ID для мгновенного входа без пароля.</p></div></div><div class="step"><div class="step-number">3</div><div class="step-content"><h4>Заполните профиль</h4><p>Укажите отображаемое имя, выберите аватарку (поддержка восьмиугольной формы), напишите bio (до 250 символов), укажите город и дату рождения (по желанию).</p></div></div><div class="step"><div class="step-number">4</div><div class="step-content"><h4>Настройте 2FA (рекомендуется)</h4><p>В настройках профиля → Безопасность → 2FA. Поддерживаются TOTP через Google Authenticator / Authy, SMS-код, email-код. Также создайте backup-коды для восстановления доступа.</p></div></div></div>

<div class="section"><h2>4. Основные экраны приложения</h2><h3>4.1 Список чатов (Главный экран)</h3><p>Главный экран — список всех ваших чатов. В верхней части: строка поиска по чатам и контактам, кнопка создания нового чата/группы/канала. Каждый элемент списка показывает: аватарку собеседника/группы, имя, последнее сообщение (обрезается до 50 символов), время отправки, количество непрочитанных сообщений (badge). Свайп влево — архивировать, свайп вправо — закрепить.</p><h3>4.2 Экран переписки</h3><p>Экран переписки — основное пространство для общения. Содержит: заголовок чата (имя, статус online/offline, количество участников), список сообщений, поле ввода с кнопками вложений и голосового сообщения.</p><ul><li><strong>Отправка сообщения</strong> — напишите текст и нажмите Enter (или кнопка отправки)</li><li><strong>Вложения</strong> — кнопка скрепки: фото, видео, файлы, документы, геолокация, контакт</li><li><strong>Голосовое сообщение</strong> — удерживайте кнопку микрофона, отпустите для отправки</li><li><strong>Реакции</strong> — наведите на сообщение, выберите эмодзи из панели реакций</li><li><strong>Ответ на сообщение</strong> — свайпните вправо или нажмите «Ответить» в меню</li><li><strong>Переслать</strong> — выберите чат или контакт для пересылки</li><li><strong>Редактирование</strong> — три точки рядом с сообщением → «Редактировать» (до 3 правок, видно количество)</li><li><strong>Удаление</strong> — три точки → «Удалить» (для всех или только для себя)</li><li><strong>Копирование</strong> — скопировать текст сообщения в буфер обмена</li></ul><h3>4.3 Профиль пользователя</h3><p>Нажмите на аватарку в чате или в поиске — откроется профиль: имя, username (@), аватарка, bio, соцсети (ссылки), статус online/offline, язык аккаунта. Кнопки: написать сообщение, видеозвонок, добавить в группы, заблокировать.</p></div>

<div class="section"><h2>5. Группы и каналы</h2><p>Balloo поддерживает два типа многопользовательских чатов: группы и каналы. Каждый имеет свои особенности и подходит для разных сценариев использования.</p><div class="cards"><div class="card"><h4>👥 Группа</h4><p>До 200 000 участников. Все участники могут писать сообщения (если не ограничено администратором). Роли: владелец (owner), администратор, модератор, участник. Идеально для общения команд, семей, друзей.</p></div><div class="card"><h4>📢 Канал</h4><p>Неограниченная аудитория подписчиков. Только администраторы и владелец могут публиковать сообщения. Идеально для новостей, блогов, образовательного контента, анонсов.</p></div><div class="card"><h4>🔗 Invite-ссылки</h4><p>Создавайте ссылки-приглашения с настройками: лимит использований (0 = безлимитно), срок действия (7/30/90 дней или навсегда), статус (активна/истекла).</p></div></div><h3>5.1 Роли и права</h3><table><tr><th>Действие</th><th>Owner</th><th>Admin</th><th>Moderator</th><th>Member</th></tr><tr><td>Удалять сообщения</td><td>✅</td><td>✅</td><td>✅</td><td>❌</td></tr><tr><td>Добавлять участников</td><td>✅</td><td>✅</td><td>❌</td><td>❌</td></tr><tr><td>Редактировать настройки</td><td>✅</td><td>✅</td><td>❌</td><td>❌</td></tr><tr><td>Писать сообщения</td><td>✅</td><td>✅</td><td>✅</td><td>✅*</td></tr><tr><td>Кикнуть участника</td><td>✅</td><td>✅</td><td>❌</td><td>❌</td></tr></table><p><em>*Если администратор не отключил право написание для всех участников</em></p></div>

<div class="section"><h2>6. Сторис (Stories)</h2><p>Сторис — этоephemeral-контент, который исчезает через 24 часа. Отличный способ делиться моментами дня без создания постоянного поста.</p><h3>6.1 Создание сторис</h3><ol><li>Нажмите на кнопку «+» в главном экране</li><li>Выберите фото из галереи или сделайте новое фото/видео</li><li>Добавьте текст, стикеры, рисунки (опционально)</li><li>Настройте видимость: все / друзья / избранные</li><li>Опубликуйте</li></ol><h3>6.2 Просмотр сторис</h3><p>Круглые аватарки пользователей вверху экрана показывают активных авторов. Тап по аватарке открывает историю. Свайп вправо — следующая история, свайп влево — предыдущая. Прогресс-бар показывает время просмотра каждой медиа-записи.</p><h3>6.3 Функции сторис</h3><ul><li>Типы медиа: фото (до 5 секунд), видео (до 60 секунд)</li><li>Срок хранения: 24 часа с момента публикации</li><li>Реакции: эмодзи (можно отправить одну реакцию на историю)</li><li>Просмотры: видно список всех пользователей, открывших историю</li><li>Приватность: можно скрыть сторис от конкретных пользователей</li><li>Повторная публикация: можно удалить и опубликовать заново</li></ul></div>

<div class="section"><h2>7. Опросы (Polls)</h2><p>Встроенная система опросов позволяет быстро собрать мнения участников чата по любому вопросу.</p><h3>7.1 Создание опроса</h3><p>В поле ввода сообщения нажмите «+» → «Опрос». Задайте вопрос, добавьте варианты ответов (от 2 до 12). Настройте: множественный выбор (да/нет), анонимность (анонимный/открытый), срок действия (24ч/7дней/30дней/без срока).</p><h3>7.2 Голосование</h3><p>Каждый участник может проголосовать за один или несколько вариантов (зависит от настроек). Результаты отображаются в реальном времени с процентным соотношением и визуальными барами.</p><h3>7.3 Завершение опроса</h3><p>Автор опроса может завершить голосование досрочно. После завершения новые голоса принимаются только если опрос не закрыт.</p></div>

<div class="section"><h2>8. Блог-платформа</h2><p>Balloo включает встроенную блог-платформу с каналами, категориями и системой модерации.</p><ul><li><strong>Создание постов</strong> — текст с форматированием, изображения, ссылки, эмбеды</li><li><strong>Каналы</strong> — тематические сообщества с подписчиками и модерацией</li><li><strong>Подписки</strong> — лента постов из каналов, на которые вы подписаны</li><li><strong>Категории</strong> — технологии, бизнес, образование, творчество, наука</li><li><strong>Поиск</strong> — полнотекстовый поиск по постам и каналам</li><li><strong>Модерация</strong> — черновики, публикация, отклонение, бан за нарушения</li></ul></div>

<div class="section"><h2>9. Безопасность и приватность</h2><div class="highlight"><p>🔒 Balloo использует многоуровневую защиту данных. Все пароли хешируются bcrypt с 12 итерациями, JWT-токены с автоматическим обновлением (access 15 мин, refresh 30 дней), двухфакторная аутентификация, отслеживание устройств и сессий.</p></div><h3>9.1 Двухфакторная аутентификация (2FA)</h3><p>Настройки → Безопасность → 2FA. Доступные методы:</p><ul><li><strong>TOTP</strong> — через Google Authenticator, Authy, Microsoft Authenticator. Код обновляется каждые 30 секунд. Рекомендуется как основной метод.</li><li><strong>SMS</strong> — код из 6 цифр на номер телефона. Удобно, но менее безопасно (SIM-swap атаки).</li><li><strong>Email</strong> — код на привязанный email. Используется как резервный метод.</li></ul><p>При включении 2FA генерируются 10 backup-кодов. Сохраните их в безопасном месте — они понадобятся для восстановления доступа.</p><h3>9.2 Управление устройствами и сессиями</h3><p>Настройки → Безопасность → Устройства. Список всех активных сессий с информацией: тип устройства (web/desktop/android/ios), название, платформа, IP-адрес, последнее время активности. Можно завершить любую сессию удалённо или все сессии сразу (при смене пароля).</p><h3>9.3 Блокировка пользователей</h3><p>На странице профиля пользователя → «Заблокировать». Заблокированный пользователь не может: писать вам сообщения, видеть ваш статус online, видеть ваши сторис, добавлять вас в группы. Вы также не видите их сообщения. Список заблокированных: Настройки → Приватность → Заблокированные.</p><h3>9.4 Шифрование данных</h3><p>Все данные передаются по HTTPS/TLS 1.3. Пароли хранятся в хешированном виде (bcrypt). JWT-токены подписываются алгоритмом EdDSA (Ed25519). Личные сообщения в direct-чатах шифруются end-to-end (планируется в v2+).</p></div>

<div class="section"><h2>10. Настройки приватности</h2><p>Гибкая система приватности позволяет контролировать, кто и какую информацию о вас может видеть.</p><table><tr><th>Параметр</th><th>Варианты</th><th>По умолчанию</th></tr><tr><td>Кто видит профиль</td><td>Все / Только друзья / Никто</td><td>Все</td></tr><tr><td>Кто видит last seen</td><td>Все / Друзья / Никто</td><td>Все</td></tr><tr><td>Кто видит аватарку</td><td>Все / Только друзья / Никто</td><td>Все</td></tr><tr><td>Кто может добавлять в группы</td><td>Все / Только друзья</td><td>Все</td></tr><tr><td>Кто видит stories</td><td>Все / Только друзья</td><td>Все</td></tr><tr><td>Кто может звонить</td><td>Все / Только друзья / Никто</td><td>Все</td></tr><tr><td>Показывать email в профиле</td><td>Да / Нет</td><td>Нет</td></tr><tr><td>Показывать номер телефона</td><td>Да / Нет</td><td>Нет</td></tr></table></div>

<div class="section"><h2>11. Языки и локализация</h2><p>Balloo поддерживает 20 языков, что делает его уникальным мессенджером для многоязычных регионов:</p><h3>11.1 Русские языки (15)</h3><p>Русский (ru), Татарский (tt), Башкирский (ba), Чеченский (ce), Чувашский (cv), Алтайский (av), Дагестанские языки (dar), Удмуртский (udm), Лезгинский (lez), Карачаево-Балкарский (kbd), Марийский (chm), Осетинский (os), Якутский (sah), Бураятский (bua), Украинский (ukr).</p><h3>11.2 Дружественные языки (3)</h3><p>Китайский (zh), Хинди (hi), Белорусский (be).</p><h3>11.3 Остальные (2)</h3><p>Английский (en), Французский (fr).</p><p>Переключение языка: Настройки → Общие → Язык. Интерфейс, уведомления и сообщения полностью переводятся на выбранный язык.</p></div>

<div class="section"><h2>12. FAQ — Частые вопросы</h2><h3>Как удалить аккаунт?</h3><p>Настройки → Аккаунт → Удалить аккаунт. Все данные будут удалены безвозвратно через 30 дней (периодGrace). Сообщения, чаты, файлы, истории — всё удаляется. Рекомендуется экспортировать данные перед удалением.</p><h3>Как сменить username?</h3><p>Настройки → Профиль → Username. Можно менять раз в 30 дней. username должен быть уникальным, от 3 до 32 символов, латиница + цифры + подчёркивание.</p><h3>Какой максимальный размер файла?</h3><p>До 50 МБ для одного файла. Поддерживаемые форматы: изображения (JPG, PNG, GIF, WEBP, SVG), видео (MP4, WEBM, MOV), аудио (MP3, WAV, FLAC, OGG), документы (PDF, DOCX, XLSX, PPTX, TXT, ZIP, RAR).</p><h3>Как восстановить удалённое сообщение?</h3><p>Удалённые сообщения восстановить нельзя. Рекомендуется использовать черновики (drafts) для важных сообщений и экспорт чатов для сохранения истории.</p><h3>Можно ли перенести историю из другого мессенджера?</h3><p>В текущей версии (v1) — нет. Перенос истории из Telegram, WhatsApp и других мессенджеров планируется в v2+.</p><h3>Как экспортировать данные?</h3><p>Настройки → Аккаунт → Экспорт данных. Доступен экспорт: профиля, списка контактов, истории чатов (текст + метаданные), списка групп и каналов.</p><h3>Что делать при взломе аккаунта?</h3><p>Срочно смените пароль через восстановление email, завершите все сессии в настройках безопасности, включите 2FA, проверьте привязанные устройства. Если не можете войти — напишите на support@balloo.su.</p></div>

<div class="section"><h2>13. Горячие клавиши (Desktop)</h2><table><tr><th>Комбинация</th><th>Действие</th></tr><tr><td>Ctrl + N</td><td>Новый чат</td></tr><tr><td>Ctrl + F</td><td>Поиск</td></tr><tr><td>Ctrl + Shift + M</td><td>Приглушить уведомления</td></tr><tr><td>Ctrl + 1-9</td><td>Переключение на чат #1-#9</td></tr><tr><td>Ctrl + Shift + K</td><td>Открыть настройки</td></tr><tr><td>Ctrl + D</td><td>Архивировать чат</td></tr><tr><td>Esc</td><td>Закрыть модальное окно</td></tr><tr><td>/</td><td>Фокус на поле ввода</td></tr></table></div>

<div class="cta-box"><h3>Готовы начать?</h3><p>Зарегистрируйтесь на app.balloo.su и присоединяйтесь к сообществу Balloo</p><div class="email">🌐 app.balloo.su • 📧 o8eryuhtin@yandex.ru</div></div>
<div class="pdf-footer">© 2026 Balloo Messenger. Все права защищены. | app.balloo.su | Версия 1.0</div>
</div></body></html>`;
}

function generateUserAdsHTML() {
  return `<!DOCTYPE html><html><head><meta charset="utf-8"><style>${COMMON_CSS}</style></head><body>
<div class="cover"><div class="logo-icon"><span>B</span></div><h1>Balloo <span class="accent">Messenger</span></h1><div class="subtitle">Мессенджер нового поколения</div><div class="meta">Рекламный буклет для пользователей</div></div>

<div class="page">
<div class="hero"><h1>Почему <span class="accent">Balloo</span>?</h1><p>Российский мессенджер, созданный для вас. Приватность, скорость, красота.</p></div>

<div class="stat-row" style="margin-top:24px;"><div class="stat-box"><div class="number">20</div><div class="label">Языков поддержки</div></div><div class="stat-box"><div class="number">50МБ</div><div class="label">Макс. размер файла</div></div><div class="stat-box"><div class="number">200K</div><div class="label">Участников в группе</div></div></div>

<div class="section"><h2>Ключевые функции</h2><div class="cards"><div class="card"><h4>💬 Сообщения</h4><p>Текст, фото, видео, голосовые, файлы, реакции, ответы, редактирование, удаление, пересылка</p></div><div class="card"><h4>📞 Звонки</h4><p>Голосовые и видеозвонки через WebRTC. Групповые до 30 человек, HD-качество</p></div><div class="card"><h4>📢 Каналы</h4><p>Неограниченная аудитория. Публикуйте новости и контент для тысяч подписчиков</p></div><div class="card"><h4>📸 Сторис</h4><p>Фото и видео на 24 часа. Реакции, просмотры, статистика, приватность</p></div><div class="card"><h4>📊 Опросы</h4><p>Создавайте опросы с одним или множественным выбором. Анонимные и открытые</p></div><div class="card"><h4>📝 Блог</h4><p>Встроенная блог-платформа. Каналы, подписки, категории, поиск</p></div></div></div>

<div class="section"><h2>Безопасность и приватность</h2><div class="highlight"><p>🔒 Все данные защищены. Шифрование, 2FA, управление сессиями, блокировка пользователей.</p></div><ul><li>Пароли хешируются bcrypt с 12 итерациями</li><li>JWT-токены с автоматическим обновлением (access 15 мин, refresh 30 дней)</li><li>Двухфакторная аутентификация: TOTP, SMS, Email + backup-коды</li><li>Отслеживание устройств и сессий — видите все входы в аккаунт</li><li>Self-hosted — ваши данные под вашим полным контролем</li><li>Шифрование TLS 1.3 при передаче данных</li><li>Блокировка пользователей — мгновенная и необратимая</li></ul></div>

<div class="section"><h2>Уникальные возможности</h2><div class="two-col"><div class="info-box"><h4>🌍 20 языков</h4><p>Уникальная поддержка 15 языков народов РФ: татарский, башкирский, чеченский, якутский, лезгинский и другие</p></div><div class="info-box"><h4>🏢 Экосистема</h4><p>Мессенджер + блог + база знаний + hiring — всё в одном продукте для бизнеса и команд</p></div><div class="info-box"><h4>🎨 Темы оформления</h4><p>Тёмная (dark), светлая (light), русская (russian — флаг РФ + драгметаллы)</p></div><div class="info-box"><h4>📱 Кроссплатформенность</h4><p>Web, Desktop (Electron), Mobile (React Native) — единая экосистема</p></div></div></div>

<div class="section"><h2>Для бизнеса и команд</h2><p>Balloo — не просто мессенджер, а полноценная платформа для коммуникации:</p><ul><li><strong>Портал сотрудников</strong> — command.balloo.su: база знаний, вакансии, онбординг</li><li><strong>Блог</strong> — корпоративный блог для внутренних и внешних публикаций</li><li><strong>Фич-реквесты</strong> — features.balloo.su: пользователи предлагают и голосуют за функции</li><li><strong>Админ-панель</strong> — admin.balloo.su: управление пользователями, модерация, аналитика</li></ul></div>

<div class="cta-box"><h3>Попробуйте Balloo уже сегодня!</h3><p>Бесплатно. Без рекламы. С уважением к вашей приватности.</p><div class="email">🌐 app.balloo.su</div></div>
<div class="pdf-footer">© 2026 Balloo Messenger. Все права защищены. | app.balloo.su</div>
</div></body></html>`;
}

function generateInvestorAdsHTML() {
  return `<!DOCTYPE html><html><head><meta charset="utf-8"><style>${COMMON_CSS}</style></head><body>
<div class="cover"><div class="logo-icon"><span>B</span></div><h1>Balloo <span class="accent">Messenger</span></h1><div class="subtitle">Инвестиционный меморандум</div><div class="meta">Июль 2026 • Конфиденциально</div></div>

<div class="page">
<div class="hero"><h1>Инвестиционный <span class="accent">меморандум</span></h1><p>Российская альтернатива мессенджерам мирового уровня</p></div>

<div class="section" style="margin-top:24px;"><h2>1. Executive Summary</h2><p>Balloo Messenger — это монорепо-архитектура, включающая мессенджер, админ-панель, портал сотрудников, систему фич-реквестов, блог, базу знаний и hiring-платформу. Продукт ориентирован на российский и СНГ-рынок с поддержкой 20 языков, включая 15 языков народов РФ.</p><div class="stat-row"><div class="stat-box"><div class="number">$2.1B</div><div class="label">Рынок мессенджеров РФ</div></div><div class="stat-box"><div class="number">148M</div><div class="label">Интернет-пользователей в РФ</div></div><div class="stat-box"><div class="number">73M</div><div class="label">Пользователей мессенджеров</div></div></div></div>

<div class="section"><h2>2. Проблема рынка</h2><p>Российские пользователи и бизнес ищут надёжные альтернативы зарубежным мессенджерам по нескольким ключевым причинам:</p><ul><li>Риски блокировок и ограничения доступа к западным платформам</li><li>Отсутствие поддержки языков народов РФ в глобальных мессенджерах</li><li>Недостаточная приватность и контроль над персональными данными</li><li>Отсутствие интегрированных решений (мессенджер + блог + hiring)</li><li>Зависимость от зарубежных облачных сервисов (Firebase, Google Cloud)</li><li>Отсутствие self-hosted решений для корпоративного сектора</li></ul></div>

<div class="section"><h2>3. Решение — Balloo</h2><p>Balloo решает все перечисленные проблемы, предлагая полноценную экосистему:</p><div class="cards"><div class="card"><h4>🇷🇺 Self-hosted</h4><p>Полный контроль над данными. Развёртывание на российских серверах. Соответствие 152-ФЗ</p></div><div class="card"><h4>🌍 20 языков</h4><p>Уникальная поддержка 15 языков народов РФ — нет аналогов на рынке</p></div><div class="card"><h4>🏢 Экосистема</h4><p>Мессенджер + блог + база знаний + hiring — всё в одном продукте</p></div></div></div>

<div class="section"><h2>4. Бизнес-модель</h2><p>Многоканальная модель монетизации обеспечивает диверсификацию доходов:</p><table><tr><th>Источник</th><th>Описание</th><th>Прогноз (год 1)</th><th>Прогноз (год 3)</th></tr><tr><td>Донаты</td><td>Уровни подписки: free, silver, gold, platinum</td><td>₽ 2.4M</td><td>₽ 12M</td></tr><tr><td>Enterprise</td><td>Self-hosted лицензии для компаний и госструктур</td><td>₽ 8M</td><td>₽ 45M</td></tr><tr><td>Реклама</td><td>Нерезидентная реклама в каналах и сторис</td><td>₽ 5M</td><td>₽ 28M</td></tr><tr><td>Hiring</td><td>Платные размещения вакансий, премиум-профили</td><td>₽ 3M</td><td>₽ 15M</td></tr><tr><td>API</td><td>Bot platform, webhook API для разработчиков</td><td>₽ 0.5M</td><td>₽ 8M</td></tr><tr><td><strong>Итого</strong></td><td></td><td><strong>₽ 18.9M</strong></td><td><strong>₽ 108M</strong></td></tr></table></div>

<div class="dark-section"><h2>5. Технологический стек</h2><p><strong>Backend:</strong> Node.js 20, Express, WebSocket (ws), Prisma ORM</p><p><strong>Database:</strong> PostgreSQL 16, Redis 7 (кэширование, сессии, rate limiting)</p><p><strong>Frontend:</strong> React 18, Vite 5, TypeScript 5, Zustand (state management)</p><p><strong>Desktop:</strong> Electron 28, cross-platform (Windows, macOS, Linux)</p><p><strong>Mobile:</strong> Expo (React Native), iOS + Android единый кодобаз</p><p><strong>Хранение:</strong> MinIO (self-hosted S3-совместимый) + Yandex Object Storage</p><p><strong>Аутентификация:</strong> JWT (EdDSA Ed25519), OAuth 2.0 (Yandex, VK, Mail.ru)</p><p><strong>Звонки:</strong> WebRTC (STUN/TURN на российских серверах)</p><p><strong>Деплой:</strong> Docker, Docker Compose, Kubernetes (v2+)</p><p><strong>Мониторинг:</strong> Prometheus + Grafana, ELK Stack (v2+)</p></div>

<div class="section"><h2>6. Roadmap развития</h2><div class="step"><div class="step-number">Q3</div><div class="step-content"><h4>2026 Q3 — Бета-релиз</h4><p>Мессенджер (сообщения, группы, звонки), регистрация, профили, 2FA, базовая админка</p></div></div><div class="step"><div class="step-number">Q4</div><div class="step-content"><h4>2026 Q4 — Публичная бета</h4><p>Сторис, опросы, блог, админ-панель, десктопное приложение, invite-ссылки</p></div></div><div class="step"><div class="step-number">2027 Q1</div><div class="step-content"><h4>2027 Q1 — Мобильные приложения</h4><p>React Native (iOS/Android), push-уведомления, офлайн-режим, PWA</p></div></div><div class="step"><div class="step-number">2027 Q2</div><div class="step-content"><h4>2027 Q2 — Enterprise</h4><p>Self-hosted решения, SSO, LDAP/Active Directory, audit logs</p></div></div><div class="step"><div class="step-number">2027 Q4</div><div class="step-content"><h4>2027 Q4 — Масштабирование</h4><p>Bot platform, API для разработчиков, интеграции, аналитика, E2E шифрование</p></div></div><div class="step"><div class="step-number">2028</div><div class="step-content"><h4>2028 — Экспансия</h4><p>Выход на рынки СНГ (Казахстан, Узбекистан), партнёрства с бизнесом</p></div></div></div>

<div class="section"><h2>7. Конкурентные преимущества</h2><table><tr><th>Критерий</th><th>Balloo</th><th>Telegram</th><th>VK Messenger</th></tr><tr><td>Языки народов РФ</td><td>✅ 15 языков</td><td>❌</td><td>❌</td></tr><tr><td>Self-hosted</td><td>✅</td><td>❌</td><td>❌</td></tr><tr><td>Блог + Hiring</td><td>✅</td><td>❌</td><td>Частично</td></tr><tr><td>Open Source</td><td>✅</td><td>❌</td><td>Частично</td></tr><tr><td>Приватность</td><td>✅ Максимальная</td><td>✅</td><td>⚠️</td></tr><tr><td>20 языков</td><td>✅</td><td>⚠️ ~10</td><td>❌</td></tr></table></div>

<div class="section"><h2>8. Финансовые показатели (прогноз)</h2><table><tr><th>Показатель</th><th>2026</th><th>2027</th><th>2028</th></tr><tr><td>Пользователи</td><td>50K</td><td>500K</td><td>2M</td></tr><tr><td>Доход</td><td>₽ 18.9M</td><td>₽ 55M</td><td>₽ 120M</td></tr><tr><td>Маржинальность</td><td>-40%</td><td>15%</td><td>35%</td></tr><tr><td>Команда</td><td>5 чел.</td><td>15 чел.</td><td>30 чел.</td></tr></table></div>

