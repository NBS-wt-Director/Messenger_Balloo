# ============================================
# Balloo Messenger — Environment Variables
# ============================================
# Заполните эти переменные перед запуском:
#   docker compose -f docker/prod/docker-compose.prod.yml up -d
#
# Все ключи взяты из instruktion_get_keys.md (2026-09-05)
# ============================================

# ============================================
# PostgreSQL 16 — основная БД
# ============================================
POSTGRES_USER="balloo"
POSTGRES_PASSWORD="balloo"
POSTGRES_DB="balloo"
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public"

# ============================================
# Redis 7 — кэш, сессии, rate limiting
# ============================================
REDIS_PASSWORD="ef7f5327f2312bd2a5a88d5815467f14853bebfb22aeb9fd6a5e57d43c66e83a"
REDIS_URL="redis://:${REDIS_PASSWORD}@redis:6379"

# ============================================
# MinIO — S3-совместимое хранилище файлов
# ============================================
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="d283226061a57f9254d86186297a0b562b6e78918445e84a11942b8935e238ed"
MINIO_ENDPOINT="minio"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_BUCKET="balloo-media"

# ============================================
# JWT — токены аутентификации
# ============================================
# Access token: 15 минут
JWT_ACCESS_SECRET="1ede20439e8333616b35eb5b64e6a7acb3389bdc25d97c0369754d880e31836c"
JWT_ACCESS_EXPIRES_IN="900"
# Refresh token: 30 дней
JWT_REFRESH_SECRET="458bddfa49870f135286ef32c0f8d26415e6fdf29dfdb711502102b1e9663a3e"
JWT_REFRESH_EXPIRES_IN="2592000"

# ============================================
# Server — бэкенд
# ============================================
SERVER_PORT="3000"
SERVER_HOST="0.0.0.0"
NODE_ENV="production"

# ============================================
# CORS — разрешённые домены
# ============================================
CORS_ORIGIN="https://balloo.su"

