# ============================================
# Balloo Messenger — Environment Variables
# ============================================

# --- PostgreSQL ---
DATABASE_URL="postgresql://balloo:PASSWORD@localhost:5432/balloo?schema=public"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_USER="balloo"
POSTGRES_PASSWORD="PASSWORD"
POSTGRES_DB="balloo"

# --- Redis ---
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# --- JWT ---
JWT_SECRET="CHANGE_ME_TO_SECURE_RANDOM_STRING"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
JWT_REFRESH_SECRET="CHANGE_ME_TO_ANOTHER_SECURE_RANDOM_STRING"

# --- Server ---
SERVER_PORT="3000"
SERVER_HOST="0.0.0.0"
NODE_ENV="development"

# --- CORS ---
CORS_ORIGIN="http://localhost:5173"

# --- OAuth ---
YANDEX_CLIENT_ID=""
YANDEX_CLIENT_SECRET=""
YANDEX_REDIRECT_URI="http://localhost:3000/api/auth/oauth/yandex/callback"
VK_CLIENT_ID=""
VK_CLIENT_SECRET=""
VK_REDIRECT_URI="http://localhost:3000/api/auth/oauth/vk/callback"
MAIL_CLIENT_ID=""
MAIL_CLIENT_SECRET=""
MAIL_REDIRECT_URI="http://localhost:3000/api/auth/oauth/mail/callback"

# --- Max OAuth ---
MAX_CLIENT_ID=""
MAX_CLIENT_SECRET=""
MAX_REDIRECT_URI="http://localhost:3000/api/auth/oauth/max/callback"

# --- Email (Self-hosted Postfix) ---
SMTP_HOST="localhost"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@balloo.su"

# --- CDN / Storage ---
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="balloo-media"
YANDEX_DISK_API_KEY=""

# --- Push Notifications (VAPID) ---
VAPID_PRIVATE_KEY=""
VAPID_PUBLIC_KEY=""
VAPID_SUBJECT="mailto:admin@balloo.su"

# --- Payments (YooKassa — двухрежимный модуль: анонимный СБП / полноценный) ---
YOOKASSA_SHOP_ID=""
YOOKASSA_API_KEY=""
# Webhook URL для HTTP-уведомлений от ЮKassa:
# https://yookassa.ru/developers/using-api/webhooks
YOOKASSA_WEBHOOK_URL="https://api.balloo.su/api/payments/webhook/yookassa"

# --- Monitoring ---
PROMETHEUS_ENABLED="true"
PROMETHEUS_PORT="9090"

# --- Setup ---
SETUP_PASSWORD=06041996ОИА

# --- File Upload ---
MAX_FILE_SIZE="52428800"
ALLOWED_IMAGE_TYPES="image/jpeg,image/png,image/gif,image/webp"
ALLOWED_FILE_TYPES="application/pdf,application/zip,application/doc,application/docx"
