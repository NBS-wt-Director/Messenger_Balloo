{
  "name": "@balloo/mobile-android",
  "version": "1.0.0",
  "private": true,
  "description": "Balloo Messenger — Expo + React Native Android app",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "echo \"No build yet\" && exit 0",
    "build:android:apk": "npx expo run:android --variant release",
    "build:android:eas": "eas build --platform android --profile apk",
    "build:android:aab": "cd android && ./gradlew bundleRelease",
    "build:android:split": "cd android && ./gradlew assembleRelease -PabiSplit=true",
    "build:android:universal": "cd android && ./gradlew assembleRelease",
    "build:android:all": "cd android && ./gradlew assembleRelease && ./gradlew bundleRelease && ./gradlew assembleRelease -PabiSplit=true",
    "upload:android": "./scripts/upload-android-to-download.sh",
    "build:android:all-and-upload": "npm run build:android:all && npm run upload:android -- ./android/app/build/outputs 1.0.0",
    "test": "echo \"No tests yet\" && exit 0",
    "lint": "npx tsc --noEmit --pretty"
  },
  "dependencies": {
    "@balloo/shared": "workspace:*",
    "@expo/vector-icons": "^14.0.0",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-native-community/netinfo": "^11.3.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@tanstack/react-query": "^5.50.0",
    "expo": "~51.0.0",
    "expo-build-properties": "~0.12.0",
    "expo-constants": "~16.0.0",
    "expo-linking": "~6.3.1",
    "expo-router": "~3.5.0",
    "expo-status-bar": "~1.12.1",
    "expo-system-ui": "~3.0.0",
    "react": "^18.3.0",
    "react-native": "0.74.0",
    "react-native-gesture-handler": "~2.16.0",
    "react-native-reanimated": "~3.10.0",
    "react-native-safe-area-context": "~4.10.0",
    "react-native-screens": "~3.31.0",
    "react-native-webview": "^13.11.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.0",
    "typescript": "^5.5.0"
  }
}
