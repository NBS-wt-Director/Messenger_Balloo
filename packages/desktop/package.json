{
  "name": "@balloo/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Balloo Messenger — Electron desktop app",
  "author": "Balloo Team <team@balloo.su>",
  "homepage": "https://balloo.su",
  "maintainers": [
    {
      "name": "Balloo Team",
      "email": "team@balloo.su",
      "url": "https://balloo.su"
    }
  ],
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:win": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "build:mac": "npm run build && electron-builder --mac --universal",
    "build:all": "npm run build && electron-builder --win --linux --mac",
    "start": "electron dist-electron/main.js",
    "test": "echo \"No tests yet\" && exit 0",
    "lint": "echo \"No linter configured yet\""
  },
  "dependencies": {
    "@balloo/shared": "workspace:*",
    "@balloo/web": "workspace:*",
    "axios": "^1.7.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.25.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0"
  }
}
