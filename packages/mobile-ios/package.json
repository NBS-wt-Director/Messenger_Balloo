{
  "name": "@balloo/mobile-ios",
  "version": "1.0.0",
  "private": true,
  "description": "Balloo Messenger — Expo + React Native iOS app (shared code with Android)",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "build": "echo \"No build yet\" && exit 0",
    "build:ios:dev": "eas build --platform ios --profile development",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:ios:release": "eas build --platform ios --profile release",
    "build:ios:local": "npx expo run:ios --configuration Release",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "dependencies": {
    "@balloo/shared": "workspace:*",
    "expo": "~51.0.0",
    "expo-status-bar": "~1.12.1",
    "react": "^18.3.0",
    "react-native": "0.74.0",
    "zustand": "^4.5.0",
    "@tanstack/react-query": "^5.50.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "^18.3.0",
    "eas-cli": "^7.0.0",
    "typescript": "^5.5.0"
  }
}