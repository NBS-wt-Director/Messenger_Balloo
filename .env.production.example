# ============================================
# Balloo Messenger — Production Environment
# ============================================
# СКОПИРУЙТЕ ЭТОТ ФАЙЛ В .env И ЗАПОЛНИТЕ ВСЕ ЗНАЧЕНИЯ
#
# Для генерации случайных секретов выполните:
#   bash scripts/generate-secrets.sh
# ============================================

# --- PostgreSQL ---
POSTGRES_PASSWORD=
POSTGRES_DB=balloo

# --- Redis ---
REDIS_PASSWORD=

# --- JWT (минимум 32 символа каждый) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- JWT Timeouts ---
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=2592000

# --- Server ---
SERVER_PORT=3000
SERVER_HOST=0.0.0.0
NODE_ENV=production

# --- CORS ---
CORS_ORIGIN=https://app.balloo.su

# --- OAuth (РФ) ---
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://app.balloo.su/api/auth/oauth/yandex/callback

VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=https://app.balloo.su/api/auth/oauth/vk/callback

MAIL_CLIENT_ID=
MAIL_CLIENT_SECRET=
MAIL_REDIRECT_URI=https://app.balloo.su/api/auth/oauth/mail/callback

# --- Max OAuth (конкурент, но пользователи и интеграция бесплатные) ---
MAX_CLIENT_ID=
MAX_CLIENT_SECRET=
MAX_REDIRECT_URI=https://app.balloo.su/api/auth/oauth/max/callback

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@balloo.su
SMTP_TLS=true

# --- CDN / Storage ---
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=balloo-media
MINIO_USE_SSL=false

# --- Push Notifications (VAPID) ---
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@balloo.su

# --- Payments (YooKassa) ---
YOOKASSA_SHOP_ID=
YOOKASSA_API_KEY=
YOOKASSA_WEBHOOK_URL=https://api.balloo.su/api/payments/webhook/yookassa

# --- Monitoring ---
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# --- Setup (для initial install) ---
ADMIN_INSTALL_PASSWORD=
SETUP_PASSWORD=

# --- Report Issue Channels ---
REPORT_ISSUE_TELEGRAM=https://t.me/balloo_support
REPORT_ISSUE_VK=https://vk.com/balloo_support
REPORT_ISSUE_MAX=https://max.balloo.su/support

# --- File Upload ---
MAX_FILE_SIZE=52428800
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
ALLOWED_FILE_TYPES=application/pdf,application/zip,application/doc,application/docx
