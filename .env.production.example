# ============================================
# Balloo Messenger — Production Environment
# ============================================
# СКОПИРУЙТЕ ЭТОТ ФАЙЛ В .env И ЗАПОЛНИТЕ ВСЕ ЗНАЧЕНИЯ
#
# Для генерации случайных секретов выполните:
#   bash scripts/generate-secrets.sh
# ============================================

# --- PostgreSQL ---
POSTGRES_PASSWORD=
POSTGRES_DB=balloo

# --- Redis ---
REDIS_PASSWORD=

# --- JWT (минимум 32 символа каждый) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- JWT Timeouts ---
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=2592000

# --- Server ---
SERVER_PORT=3000
SERVER_HOST=0.0.0.0
NODE_ENV=production

# --- API origin (Вариант C: всё API на отдельном поддомене) ---
# VITE_API_URL — базовый origin API, запeкается в бандль web на vite build
# (docker/Dockerfile.web, docker-compose build.args). Голый origin без слэша;
# клиент сам дописывает /api/... Итог: https://api.balloo.su/api/...
VITE_API_URL=https://api.balloo.su
# APP_URL — публичный origin ФРОНТЕНДА (один URL, не список): возврат после
# OAuth, ссылки писем (verify/reset), возврат платежей.
APP_URL=https://balloo.su

# --- CORS (разрешительный СПИСОК origin'ов через запятую, без пробелов) ---
# Только cors-middleware (credentials:true) и CSP connectSrc. Без '*' с credentials.
CORS_ORIGIN=https://balloo.su,https://admin.balloo.su,https://command.balloo.su,https://features.balloo.su,https://blog.balloo.su,https://history.balloo.su,https://download.balloo.su,https://docs.balloo.su

# --- OAuth (РФ) — redirect_uri на api-поддомене, должны 1-в-1 совпадать
# с Callback URL в панелях провайдеров (Яндекс/VK/Mail.ru) ---
YANDEX_CLIENT_ID=d510d63d88f643859ff0e2e3890bb199
YANDEX_CLIENT_SECRET=0b8eb9995f8e42ccbeff0cf12f944b48
YANDEX_REDIRECT_URI=https://api.balloo.su/api/auth/oauth/yandex-callback

VK_CLIENT_ID=54752550
VK_CLIENT_SECRET=iwjsvqAhRMUeNjRMdMO1
VK_REDIRECT_URI=https://api.balloo.su/api/auth/oauth/vk/callback

MAILRU_CLIENT_ID=01a067110db474148019fe5602471858
MAILRU_CLIENT_SECRET=01a067110db4741fae9f5ccda45ba826
MAILRU_REDIRECT_URI=https://api.balloo.su/api/auth/oauth/mailru/callback

# --- Email (SMTP) — self-hosted Postfix по умолчанию ---
# Для production: SMTP_HOST=smtp.mail.ru или smtp.yandex.ru
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@balloo.su
SMTP_TLS=false

# --- CDN / Storage ---
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=balloo-media
MINIO_USE_SSL=false

# --- Push Notifications (VAPID Web Push) ---
# Сгенерировать: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@balloo.su

# --- Payments (ЮKassa — ЗАГЛУШКА) ---
# В v1: Донаты только по СБП (+79122023035, QR-код)
# ЮKасса будет подключена позже
YOOKASSA_SHOP_ID=
YOOKASSA_API_KEY=
YOOKASSA_WEBHOOK_URL=https://api.balloo.su/api/payments/webhook/yookassa

# --- Monitoring ---
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# --- Яндекс.Метрика (аналитика, consent-based: загружается после «Принять все» в CookieBanner) ---
# ID счётчика из Яндекс.Метрики (число). Пусто = Метрика не подключается.
VITE_YM_METRIKA_ID=

# --- Setup (для initial install) ---
ADMIN_INSTALL_PASSWORD=
SETUP_PASSWORD=

# --- Report Issue Channels ---
REPORT_ISSUE_TELEGRAM=https://t.me/balloo_support
REPORT_ISSUE_VK=https://vk.com/balloo_support

# --- File Upload ---
MAX_FILE_SIZE=52428800
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
ALLOWED_FILE_TYPES=application/pdf,application/zip,application/doc,application/docx